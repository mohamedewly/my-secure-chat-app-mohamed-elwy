{
  "name": "secure-chat-server",
  "version": "1.0.0",
  "description": "Real-time encrypted chat: WebSocket server + MongoDB, with client-side E2E encryption and a server-side at-rest encryption layer.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen-jwt-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen-vapid": "node -e \"console.log(require('web-push').generateVAPIDKeys())\"",
    "test:crypto": "node lib/crypto.selftest.js",
    "test:auth": "node lib/auth.selftest.js",
    "test:storage": "node lib/storage.selftest.js",
    "test:all": "npm run test:crypto && npm run test:auth && npm run test:storage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.9.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
